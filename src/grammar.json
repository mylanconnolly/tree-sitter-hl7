{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "hl7",
  "rules": {
    "document": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_line"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_newline"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_line"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "header"
        },
        {
          "type": "SYMBOL",
          "name": "segment"
        }
      ]
    },
    "header": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "STRING",
                "value": "MSH"
              },
              {
                "type": "STRING",
                "value": "FHS"
              },
              {
                "type": "STRING",
                "value": "BHS"
              }
            ]
          },
          "named": true,
          "value": "segment_name"
        },
        {
          "type": "SYMBOL",
          "name": "field_separator"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "encoding_characters"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        }
      ]
    },
    "segment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "segment_name"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_token"
          }
        }
      ]
    },
    "_token": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "field_separator"
        },
        {
          "type": "SYMBOL",
          "name": "component_separator"
        },
        {
          "type": "SYMBOL",
          "name": "repetition_separator"
        },
        {
          "type": "SYMBOL",
          "name": "subcomponent_separator"
        },
        {
          "type": "SYMBOL",
          "name": "escape_sequence"
        },
        {
          "type": "SYMBOL",
          "name": "text"
        }
      ]
    },
    "segment_name": {
      "type": "PATTERN",
      "value": "[A-Z][A-Z0-9]{2}"
    },
    "field_separator": {
      "type": "PATTERN",
      "value": "\\|+"
    },
    "component_separator": {
      "type": "PATTERN",
      "value": "\\^+"
    },
    "repetition_separator": {
      "type": "PATTERN",
      "value": "~+"
    },
    "subcomponent_separator": {
      "type": "PATTERN",
      "value": "&+"
    },
    "encoding_characters": {
      "type": "IMMEDIATE_TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^|\\r\\nA-Za-z0-9 ]{1,6}"
      }
    },
    "escape_sequence": {
      "type": "PATTERN",
      "value": "\\\\[^\\\\|\\r\\n]*\\\\"
    },
    "text": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": "[^|^~&\\\\\\r\\n]+"
        },
        {
          "type": "STRING",
          "value": "\\"
        }
      ]
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\r\\n|\\r|\\n"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}